[Unit]
Description=Smart clock Claude usage relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clockrelay
Group=clockrelay
EnvironmentFile=/etc/clock-usage-relay/relay.env
ExecStart=/usr/bin/python3 /opt/clock-usage-relay/clock_usage_relay.py
Restart=on-failure
RestartSec=10
StateDirectory=clock-usage-relay
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
