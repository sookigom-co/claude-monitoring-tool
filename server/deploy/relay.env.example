# /etc/clock-usage-relay/relay.env  (root:clockrelay 640) — no secret values in this file
# Front nginx on another server: bind to this host's LAN address and trust only the nginx address.
RELAY_BIND=0.0.0.0
RELAY_PORT=8787
RELAY_TRUSTED_PROXIES=NGINX_PROXY_IP
# Upstream sample interval in seconds (min 60, max 48 calls/day at 1800). Do not also set RELAY_CACHE_SECONDS.
RELAY_SAMPLE_SECONDS=1800
# Days of samples kept in samples.db (min 2).
RELAY_SAMPLE_RETENTION_DAYS=14
# Sample file; defaults to $STATE_DIRECTORY/samples.db, i.e. /var/lib/clock-usage-relay/samples.db under systemd.
#RELAY_SAMPLES_DB=/var/lib/clock-usage-relay/samples.db
RELAY_TZ=Asia/Seoul
RELAY_CREDENTIALS_FILE=/var/lib/clock-usage-relay/credentials.json
RELAY_CLOCK_TOKEN_FILE=/var/lib/clock-usage-relay/clock_token
